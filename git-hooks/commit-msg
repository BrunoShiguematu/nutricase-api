#!/bin/sh
# Bloqueia commits que atribuem autoria ao Claude ou à Anthropic.
if grep -qiE 'co-authored-by:.*(claude|anthropic)|generated with.*claude|noreply@anthropic\.com' "$1"; then
  echo "Commit bloqueado: a mensagem atribui autoria ao Claude/Anthropic." >&2
  echo "Remova essa linha e tente de novo. Commits saem só em nome do grupo." >&2
  exit 1
fi
